{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "routes": [
    {
      "route": "/vendor/*",
      "headers": {
        "Cache-Control": "public, max-age=604800"
      }
    },
    {
      "route": "/assets/*",
      "headers": {
        "Cache-Control": "public, max-age=604800"
      }
    },
    {
      "route": "/css/*",
      "headers": {
        "Cache-Control": "public, max-age=86400"
      }
    },
    {
      "route": "/dados/*",
      "headers": {
        "Cache-Control": "public, max-age=3600"
      }
    },
    {
      "route": "/js/*",
      "headers": {
        "Cache-Control": "public, max-age=3600"
      }
    },
    {
      "route": "/config.js",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/index.html",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/api/*",
      "headers": {
        "Cache-Control": "no-store"
      }
    },
    {
      "route": "/login",
      "rewrite": "/index.html"
    },
    {
      "route": "/",
      "redirect": "/login",
      "statusCode": 302
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/api/*",
      "/vendor/*",
      "/config.js",
      "/auth.html",
      "*.{png,jpg,svg,ico,css,js}"
    ]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Strict-Transport-Security": "max-age=31536000; includeSubDomains",
    "Content-Security-Policy": "default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://login.microsoftonline.com https://graph.microsoft.com https://cdnjs.cloudflare.com https://*.sharepoint.com https://brasilapi.com.br https://opencep.com; worker-src 'self' blob: https://cdnjs.cloudflare.com; frame-src https://login.microsoftonline.com; frame-ancestors 'none'; object-src 'none'; base-uri 'none'; form-action 'none'",
    "Permissions-Policy": "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
  },
  "mimeTypes": {
    ".json": "application/json",
    ".js": "text/javascript"
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/index.html"
    }
  }
}
